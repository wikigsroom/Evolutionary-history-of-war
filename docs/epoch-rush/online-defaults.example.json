{
  "status": "design-draft-not-runtime-config",
  "design_date": "2026-10-11",
  "baseline_game_version": "0.7.3",
  "protocol_version": "1.0",
  "ruleset_id": "pvp-classic-v1",
  "transport": {
    "public_protocol": "wss",
    "public_port": 443,
    "subprotocol": "epoch-rush.v1",
    "tls_certificate_verification": true,
    "websocket_ticket_ttl_seconds": 30,
    "compression_enabled_initially": false,
    "client_inbound_buffer_bytes": 1048576,
    "max_queued_packets": 256,
    "max_control_message_bytes": 8192,
    "max_action_payload_bytes": 2048,
    "max_delta_bytes": 32768,
    "max_full_snapshot_bytes": 262144,
    "snapshot_chunk_bytes": 32768,
    "snapshot_assembly_timeout_seconds": 10,
    "backpressure_bytes": 262144,
    "stale_state_threshold_seconds": 1
  },
  "simulation": {
    "tick_hz": 30,
    "state_hz": 10,
    "minimum_input_delay_ticks": 2,
    "client_simulates_authoritative_combat": false,
    "interpolation_min_ms": 80,
    "interpolation_max_ms": 150,
    "max_extrapolation_ms": 100,
    "human_economy_multiplier": 1.0,
    "equal_hero_pool_size": 6,
    "mastery_points_per_player": 6,
    "common_skill_slots": 2,
    "maximum_relic_slots": 2,
    "starting_gold_per_side": 240,
    "starting_gold_per_second": 2.5,
    "starting_era_id": "A1",
    "maximum_era_id": "A10",
    "damaging_random_events": false,
    "evolution_fully_heals_own_capital": true,
    "capital_growth_source": "troop-era-hp-multiplier",
    "overtime_burn_start_simulation_seconds": 1800,
    "maximum_match_simulation_seconds": 2400,
    "time_limit_result": "DRAW"
  },
  "commands": {
    "rate_per_player_per_second": 20,
    "burst_per_player": 40,
    "max_unresolved_per_player": 64,
    "targeted_action_ttl_ms": 500,
    "strategy_action_ttl_ms": 2000,
    "automatic_replay_of_offline_clicks": false,
    "deduplication_key": ["match_id", "player_id", "client_seq"]
  },
  "rooms": {
    "code_pattern": "^[0-9]{6}$",
    "code_as_string": true,
    "active_code_namespace": "global",
    "maximum_members": 2,
    "default_visibility": "code-only",
    "single_player_wait_ttl_seconds": 300,
    "pre_match_absolute_ttl_seconds": 600,
    "lobby_disconnected_seat_hold_seconds": 60,
    "code_reuse_cooldown_seconds": 90,
    "code_submissions_per_player_per_minute": 10,
    "room_creations_per_player_per_minute": 5,
    "loading_timeout_seconds": 30
  },
  "matchmaking": {
    "initial_region_count": 1,
    "offer_confirmation_seconds": 15,
    "preferred_rtt_ms": 120,
    "expanded_rtt_ms": 180,
    "no_opponent_notice_seconds": 75,
    "skill_windows": [
      {"wait_from_seconds": 0, "difference": 150},
      {"wait_from_seconds": 20, "difference": 300},
      {"wait_from_seconds": 40, "difference": 500}
    ],
    "ai_may_impersonate_human": false
  },
  "reconnect": {
    "heartbeat_seconds": 2,
    "suspect_after_seconds": 4,
    "disconnect_after_seconds": 8,
    "retry_delays_seconds": [0, 1, 2, 4],
    "retry_cap_seconds": 4,
    "retry_jitter_ratio": 0.2,
    "single_absence_grace_seconds": 120,
    "cumulative_absence_budget_seconds": 180,
    "technical_pause_max_per_event_seconds": 8,
    "technical_pause_budget_per_player_seconds": 15,
    "both_disconnected_abort_seconds": 60,
    "online_menu_pauses_simulation": false,
    "autonomous_armies_continue_after_technical_pause": true,
    "ai_takeover": false,
    "platform_outage_consumes_player_grace": false
  },
  "durability": {
    "commit_batch_ms": 100,
    "checkpoint_interval_seconds": 5,
    "owner_lease_seconds": 6,
    "owner_lease_renew_seconds": 2,
    "owner_epoch_fencing": true,
    "publish_only_after_durable_commit": true,
    "maximum_uncommitted_simulation_seconds": 1,
    "production_requires_synchronous_database_failover": true,
    "recovery_hard_deadline_seconds": 30,
    "replay_hash_mismatch_policy": "SERVER_ABORTED",
    "authoritative_store": "PostgreSQL",
    "redis_is_optional_rebuildable_cache": true
  },
  "rollout": {
    "initial_public_match_limit_target": 50,
    "capacity_is_benchmarked": false,
    "ranked_enabled_initially": false,
    "local_docker_wsl_or_virtualization_allowed": false
  }
}
