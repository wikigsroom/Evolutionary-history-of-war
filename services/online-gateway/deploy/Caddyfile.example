# Set EPOCH_PUBLIC_HOST to your separately provisioned game domain.
# The privacy-policy domain continues to serve the privacy page.
{$EPOCH_PUBLIC_HOST} {
    @internal path /healthz /metrics /admin/*
    respond @internal 404
    reverse_proxy 127.0.0.1:28187 {
        header_up X-Real-IP {remote_host}
        flush_interval -1
        stream_close_delay 5m
    }
}
